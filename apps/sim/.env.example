# Agent tier selection: unset = auto (Groq -> Gemini -> scripted), or force one of: scripted | groq | gemini
AGENT=

# Tier 1: Groq (OpenAI-compatible chat completions with function calling)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tier 2: Gemini (native function declarations via @google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Where the real MCP server is running
MCP_URL=http://127.0.0.1:3301/mcp
MCP_TOKEN=
